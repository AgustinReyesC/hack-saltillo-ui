# Build de producción (CloudFront). `vite build` carga este archivo encima de `.env`.
# CloudFront manda /api/* al ALB de la API (quita el prefijo /api), así que todo va por el
# mismo origen HTTPS: sin CORS ni contenido mixto. El chat es POST /api/chat (la API invoca al agente).
VITE_USE_MOCKS=false
VITE_API_URL=/api
VITE_CHAT_URL=/api
